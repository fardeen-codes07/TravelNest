<% layout("/layouts/boilerplate")%>
<div class="row">
    <div class="col-8 offset-2">
        <br><br>
        <div class="container mt-5">
            <form method="POST" action="/listings" novalidate class="needs-validation" enctype="multipart/form-data">
                <h1>Create New Listing</h1>
                    <div class="mb-3">
                        <label for="title" class="form-label">Title</label>
                        <input name="listing[title]" 
                        placeholder="enter title" 
                        type="text" 
                        class="form-control" required>
                    </div>
                    <div class="invalid-feedback">
                        Enter title
                    </div>
                    <div class="mb-3">
                        <label for="desription" class="form-description">Description</label>
                        <textarea name="listing[description]" 
                        class="form-control" required></textarea>
                    </div>
                    <div class="invalid-feedback">
                        Enter short description
                    </div>
                    <div class="mb-3">
                        <label for="image" class="form-label">Upload Image</label>
                        <input name="listing[image]" type="file" class="form-control">
                    </div>
                    <div class="invalid-feedback">
                        Enter valid url
                    </div>
                    <div class="mb-3">
                        <label for="price" class="form-label">Price</label>
                        <input name="listing[price]" 
                        placeholder="enter price" 
                        type="number" 
                        class="form-control" 
                        min="0"
                        required>
                    </div>
                    <div class="invalid-feedback">
                        Enter price
                    </div>
                    <div class="mb-3">
                        <label for="country" class="form-label">Country</label>
                        <input name="listing[country]" placeholder="enter country" type="text" class="form-control" required>
                    </div>
                    <div class="invalid-feedback">
                        Enter country
                    </div>
                    <div class="mb-3">
                        <label for="location" class="form-label">Location</label>
                        <input name="listing[location]" placeholder="enter location" type="text" class="form-control" required>
                    </div>
                    <div class="invalid-feedback">
                        Enter location
                    </div>
                    <br><br>
                    <button class="btn btn-dark add-btn">Add </button>
                </form>
            </div>
    </div>
</div>
